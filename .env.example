# Example environment configuration for Dagster + dbt project
# Copy this file to .env and adjust the paths as needed

# Dagster configuration
# Store Dagster runs and metadata in the project directory
DAGSTER_HOME=./.dagster

# Optional: Set log level for more verbose output during development
# DAGSTER_LOG_LEVEL=DEBUG

# Optional: Set Dagster database URL (defaults to SQLite in DAGSTER_HOME)
# DAGSTER_DATABASE_URL=sqlite:///path/to/dagster.db